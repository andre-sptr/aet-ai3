{
  "name": "aet-ai",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "test:live": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-sumopod.mjs",
    "test:benchmark": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-all-models.mjs",
    "test:benchmark:plan": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-all-models.mjs --plan",
    "test:history": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/conversation-deletion.test.mts tests/streaming.test.mts tests/cms-history.test.mts",
    "test:http": "node scripts/check-http.mjs",
    "postinstall": "prisma generate",
    "test:tools": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-tools.mjs",
    "test:vision": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-vision.mjs",
    "test:live-app": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-live-app.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.0.0",
    "katex": "0.18.2",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "next": "16.4.2",
    "pdf-parse": "^2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.27",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "katex": "$katex",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
