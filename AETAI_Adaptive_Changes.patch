+        if (e.kind==='statistics') answer=state.language==='en'?`Mean: ${d.mean}; median: ${d.median}; sum: ${d.sum}.`:`Rata-rata: ${d.mean}; median: ${d.median}; jumlah: ${d.sum}.`;
+        if (answer) origin='application';
