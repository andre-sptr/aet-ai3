# SQLite: path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Required for live AI responses. Supply your own key.
SUMOPOD_API_KEY=""
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"

# Required for admin sign-in. Set your own values.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Required: independent random secret, at least 32 characters.
ADMIN_SESSION_SECRET=""

# Exact public URL, required in production (no trailing path).
APP_ORIGIN="http://localhost:3000"

# Set a strong private signing secret for Frontier access.
AET_FRONTIER_ACCESS_SECRET=""

# Frontier is opt-in because current pricing has not been verified.
ENABLE_FRONTIER="false"

# Enable only behind a proxy that overwrites x-forwarded-for.
TRUST_PROXY="false"

# Per-process global request cap; also set a spend cap at the AI provider.
CHAT_HOURLY_LIMIT="100"

# Optional: web search tool.
TAVILY_API_KEY=""

# Required only for uploading admin images to Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Optional benchmark guard (not read by browser code). These numbers alone do NOT
# enforce USD spend. Supply a recent operator-verified provider cap policy first.
AET_LIVE_TEST_APPROVED="false"
AET_TEST_BUDGET_USD="3"
AET_BENCHMARK_BUDGET_FILE=""
AET_BENCHMARK_MAX_REQUESTS="96"
AET_BENCHMARK_MAX_TOKENS="512"
AET_BENCHMARK_PRICING_FILE=""

# Server-only routing. Legacy client model fields are ignored.
# off keeps the default; shadow recommends without switching; adaptive requires
# schema-v2 application evidence, human review and usage-derived costs. Screening
# alone cannot promote a model; v1 self-asserted metrics are rejected. Uncalibrated modes
# still have distinct strategies on the same gpt-4o-mini baseline.
AET_ROUTING_MODE="off"
AET_ROUTING_POLICY_FILE=""
# Policy references are cached for at most 30 seconds. Restart to apply/revoke
# an artifact immediately. See docs/routing-policy-guide.md for the v2 contract.
# The supplied docs/routing-policy.pending.json is intentionally not active.

# Adaptive orchestration: defaults fit the route maxDuration=60 seconds.
# This override may only REDUCE the 30s/45s/55s mode deadlines.
AET_CHAT_DEADLINE_MS=""
AET_PROVIDER_MAX_CONCURRENT="4"
AET_PROVIDER_CALLS_PER_MINUTE="120"
# Optional local per-request cost estimate ceiling. Requires verified pricing.
# Missing prices fail closed when a USD ceiling is configured.
AET_MAX_REQUEST_USD=""
AET_RUNTIME_PRICING_FILE=""
# Runtime estimates are not provider billing or a provider-side spending cap.
# Operator evaluator only, never read from an HTTP model-selection payload:
# AET_EVALUATION_FRONTIER_TOKEN="" (a valid existing Frontier access token).
# ENABLE_FRONTIER and per-attempt checks still apply. Do not put tokens in reports.
# For test:ai --live after test:ai:setup and operator verification:
# AET_BENCHMARK_BUDGET_FILE="evaluation/budget.json"
# AET_BENCHMARK_PRICING_FILE="evaluation/pricing.json"
